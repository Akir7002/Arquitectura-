# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# NUNCA subas el archivo ".env" real a control de versiones (ver .gitignore).

# --- Metadatos de la aplicación ---
APP_NAME="Users API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true

# --- Base de datos ---
# SQLite async para el ejemplo. En producción: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# --- Seguridad JWT ---
# Genera una clave fuerte con: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
