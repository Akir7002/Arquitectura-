        <mxCell id="layer1" value="1. ENTRADA&#xa;&#xa;projectdev/src/main/java/.../controller&#xa;&#xa;ClientesController.java&#xa;ProductosController.java&#xa;PedidosController.java&#xa;Endpoints REST&#xa;ResponseEntity" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontSize=14;horizontal=1;startSize=32;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="400" as="geometry"/></mxCell>
