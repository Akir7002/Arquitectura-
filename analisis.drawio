        <mxCell id="n7" value="7 · PUERTOS (Protocol) — interfaces del dominio&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;core/ports: UserRepo · UserUnitOfWork · Hasher — las dependencias apuntan hacia adentro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
