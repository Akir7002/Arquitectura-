<mxfile host="app.diagrams.net" agent="GitHub Copilot" compressed="false" pages="4">
  <diagram id="overview" name="01 - Arquitectura general">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Event-Driven Monolith PoC - arquitectura de componentes" style="text;html=1;fontSize=24;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="client" value="Cliente&#xa;Web / Mobile / Postman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="220" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="app" value="CONTENEDOR app&#xa;&#xa;FastAPI + Uvicorn&#xa;main.py - endpoints HTTP/SSE&#xa;services.py - lógica de negocio&#xa;core.py - inicialización y consumidores&#xa;schemas.py - validación Pydantic&#xa;utils.py - JWT, bcrypt, Fernet" style="swimlane;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;horizontal=1;startSize=34;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="310" y="130" width="410" height="300" as="geometry"/></mxCell>
        <mxCell id="db" value="CONTENEDOR couchdb&#xa;&#xa;CouchDB 3.3&#xa;HTTP :5984&#xa;Single node&#xa;6 bases de documentos&#xa;Índices Mango" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="820" y="130" width="260" height="210" as="geometry"/></mxCell>
        <mxCell id="mq" value="CONTENEDOR rabbitmq&#xa;&#xa;RabbitMQ 3.12 Management&#xa;AMQP :5672&#xa;Exchanges fanout&#xa;Colas temporales por consumidor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="820" y="390" width="260" height="190" as="geometry"/></mxCell>
        <mxCell id="pay" value="Simulador de proveedor de pagos&#xa;&#xa;Endpoint interno /create-checkout&#xa;Desencripta datos Fernet&#xa;Procesa en ThreadPoolExecutor&#xa;Llama /payment-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1160" y="170" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="csv" value="Entrada administrativa&#xa;&#xa;src/recipes.csv&#xa;POST /load-recipes&#xa;CSV tabulado&#xa;Validación y slugificación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="40" y="480" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="o1" value="HTTP / SSE" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="client" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o2" value="HTTP REST" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o3" value="publish / consume" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="mq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o4" value="checkout + webhook" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o5" value="carga de recetas" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="csv" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Es un solo proceso/despliegue de aplicación, pero sus funcionalidades se separan por contratos, bases lógicas y eventos. RabbitMQ desacopla productores y consumidores sin convertirlos en microservicios." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15" vertex="1" parent="1"><mxGeometry x="330" y="690" width="900" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="components" name="02 - Componentes y persistencia">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Componentes internos, eventos y bases CouchDB" style="text;html=1;fontSize=24;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="api" value="API FastAPI&#xa;&#xa;/signup, /login&#xa;/confirm-email(-api)&#xa;/load-recipes&#xa;/get-all-recipes&#xa;/get-recipe-details&#xa;/buy-recipe&#xa;/payment-webhook&#xa;/create-checkout&#xa;/notifications" style="swimlane;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;horizontal=1;startSize=34;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="120" width="270" height="390" as="geometry"/></mxCell>
        <mxCell id="svc" value="Servicios de negocio&#xa;&#xa;Auth: sign up, login, confirmación&#xa;Recipes: importar, guardar, consultar&#xa;Purchase: checkout, webhook, estados&#xa;Consumers: email_confirmation, enable_user, add_user_recipe, update_recipe_status&#xa;Notifications: cola SimpleQueue + SSE" style="swimlane;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;horizontal=1;startSize=34;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="380" y="120" width="330" height="390" as="geometry"/></mxCell>
        <mxCell id="events" value="RabbitMQ&#xa;exchanges fanout&#xa;&#xa;user-signed-up&#xa;email-confirmed&#xa;recipe-purchase-requested&#xa;purchase-status-changed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="800" y="150" width="280" height="250" as="geometry"/></mxCell>
        <mxCell id="couch" value="CouchDB (document databases)&#xa;&#xa;user-credentials&#xa;user-info&#xa;email-confirmation&#xa;recipe&#xa;user-recipe&#xa;payment&#xa;&#xa;Acceso vía database.py usando HTTPX y _find/_index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="e1" value="llama servicios" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="lee/escribe" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="svc" target="couch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="publica y consume" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="svc" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="fanout a consumidores" style="endArrow=block;html=1;dashed=1;fontSize=13" edge="1" parent="1" source="events" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="Regla de datos: no existe una base relacional ni ORM. CouchDB almacena documentos JSON y cada base representa un límite funcional. Los estados de recetas del usuario y pagos se actualizan de forma eventual por eventos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15" vertex="1" parent="1"><mxGeometry x="230" y="620" width="1050" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="signup" name="03 - Flujo alta y autenticación">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Flujo de alta, confirmación de correo y login" style="text;html=1;fontSize=24;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="u" value="Cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="180" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="api" value="FastAPI&#xa;/signup&#xa;/confirm-email&#xa;/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="150" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="authdb" value="CouchDB&#xa;user-credentials&#xa;user-info&#xa;email-confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="120" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="mq" value="RabbitMQ fanout&#xa;user-signed-up&#xa;email-confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="940" y="120" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="cons" value="Consumidores en hilos&#xa;&#xa;email_confirmation: crea JWT de confirmación, persiste token y simula envío por stdout&#xa;&#xa;enable_user: marca validated=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1270" y="110" width="290" height="210" as="geometry"/></mxCell>
        <mxCell id="a" value="POST datos" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="u" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b" value="guardar usuario" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="api" target="authdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c" value="publicar" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="api" target="mq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d" value="consume" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="mq" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e" value="token / validated" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="cons" target="authdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n" value="Después de confirmar, /login valida bcrypt y validated; genera JWT HS256 con expiración de 24 horas. Los endpoints protegidos validan ese JWT mediante OAuth2PasswordBearer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15" vertex="1" parent="1"><mxGeometry x="250" y="500" width="1000" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="purchase" name="04 - Flujo compra y eventos">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Flujo de compra, pago asíncrono y notificaciones" style="text;html=1;fontSize=24;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u" value="Cliente&#xa;POST /buy-recipe&#xa;GET /notifications (SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="180" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="app" value="Aplicación FastAPI&#xa;&#xa;start_checkout&#xa;payment_processing&#xa;update_payment_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="360" y="150" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="provider" value="Simulador de pagos&#xa;&#xa;/create-checkout&#xa;Fernet + API key&#xa;ThreadPoolExecutor&#xa;espera 1-5 min&#xa;/payment-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="740" y="130" width="270" height="210" as="geometry"/></mxCell>
        <mxCell id="payment" value="CouchDB&#xa;payment&#xa;&#xa;checkout_id -> user_id&#xa;payment_id, recipe_id&#xa;payment_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="mq" value="RabbitMQ&#xa;&#xa;recipe-purchase-requested&#xa;purchase-status-changed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="740" y="470" width="290" height="180" as="geometry"/></mxCell>
        <mxCell id="cons" value="Consumidores fanout&#xa;&#xa;add_user_recipe -> user-recipe (REQUESTED)&#xa;send_purchase_notification -> SimpleQueue por usuario&#xa;update_recipe_status -> user-recipe (PURCHASED)&#xa;notify_recipe_state_change -> SimpleQueue por usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="390" height="260" as="geometry"/></mxCell>
        <mxCell id="r" value="CouchDB&#xa;recipe + user-recipe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="360" y="480" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="a" value="1. checkout" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="u" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b" value="2. HTTP interno" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c" value="3. guardar checkout" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d" value="4. webhook" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="provider" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e" value="5. guardar estado" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f" value="6. publicar eventos" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="app" target="mq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g" value="7. fanout" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="mq" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h" value="8. persistir" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="cons" target="r"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i" value="9. SSE" style="endArrow=block;html=1;fontSize=13" edge="1" parent="1" source="cons" target="u"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n" value="El pago simulado siempre termina en PAID después de una espera aleatoria. El flujo real es asíncrono: la compra responde antes de que el estado pase de REQUESTED a PURCHASED. RabbitMQ permite que persistencia y notificaciones reaccionen de forma independiente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15" vertex="1" parent="1"><mxGeometry x="300" y="760" width="1050" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
