FROM python:3.11-slim-bookworm

# Expose uvicorn port
EXPOSE 80

# Expose Pudb (debugger) port
EXPOSE 1984

WORKDIR /deploy

COPY . /deploy

# Update image packages and install runtime utilities.
RUN apt-get update \
    && apt-get install -y --no-install-recommends locales curl \
    && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Install and upgrade pip.
RUN python3 -m pip install --upgrade pip

# Install requirements (you can install manually requirements-dev.txt in your local environment).
RUN pip3 install -r requirements.txt

# Starts FastAPI server.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "80", "--reload"]
