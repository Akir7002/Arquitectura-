  <diagram id="request-role" name="04 - Peticion con Role">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="Ciclo de una peticion con User y Role" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="850" height="40" as="geometry"/></mxCell>
      <mxCell id="s1" value="1&#xa;Cliente&#xa;envia JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="100" as="geometry"/></mxCell>
      <mxCell id="s2" value="2&#xa;Router User o Role&#xa;valida DTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="170" height="100" as="geometry"/></mxCell>
      <mxCell id="s3" value="3&#xa;Depends&#xa;inyecta UoW" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="150" height="100" as="geometry"/></mxCell>
      <mxCell id="s4" value="4&#xa;Use case&#xa;aplica reglas" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="150" height="100" as="geometry"/></mxCell>
      <mxCell id="s5" value="5&#xa;Repo User / Role&#xa;consulta o guarda" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="180" height="100" as="geometry"/></mxCell>
      <mxCell id="s6" value="6&#xa;PostgreSQL&#xa;users + roles" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="150" width="180" height="100" as="geometry"/></mxCell>
      <mxCell id="s7" value="7&#xa;Respuesta DTO&#xa;incluye role_id" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;fontSize=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="80" height="100" as="geometry"/></mxCell>
      <mxCell id="note" value="Cuando se crea o actualiza User con role_id, el UUID cruza DTO -> caso de uso -> entidad -> repositorio -> users.role_id.&#xa;La FK conecta users.role_id con roles.id en PostgreSQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="360" width="900" height="100" as="geometry"/></mxCell>
      <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="role-flow" name="05 - Flujo completo de Role">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="Flujo funcional de la entidad Role" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="40" as="geometry"/></mxCell>
      <mxCell id="create" value="CREAR ROLE&#xa;&#xa;POST /api/v1/roles&#xa;1. CreateRoleRequest&#xa;2. Validar nombre&#xa;3. Buscar duplicado&#xa;4. Crear Role con ID&#xa;5. RoleRepo.save&#xa;6. RoleUoW.commit&#xa;7. RoleResponse / 201" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="300" as="geometry"/></mxCell>
      <mxCell id="read" value="CONSULTAR ROLE&#xa;&#xa;GET /api/v1/roles/{id}&#xa;1. Validar UUID&#xa;2. GetRoleUsecase&#xa;3. RoleRepo.get_by_id&#xa;4. Convertir DBRole a Role&#xa;5. RoleResponse / 200&#xa;&#xa;No encontrado -> 404" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="300" height="300" as="geometry"/></mxCell>
      <mxCell id="update" value="ACTUALIZAR ROLE&#xa;&#xa;PATCH /api/v1/roles/{id}&#xa;1. UpdateRole DTO&#xa;2. Buscar Role actual&#xa;3. Validar nueva entidad&#xa;4. RoleRepo.update&#xa;5. RoleUoW.commit&#xa;6. RoleResponse / 200" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="300" height="300" as="geometry"/></mxCell>
      <mxCell id="delete" value="ELIMINAR ROLE&#xa;&#xa;DELETE /api/v1/roles/{id}&#xa;1. DeleteRoleUsecase&#xa;2. RoleRepo.delete&#xa;3. Responder 204 / 404&#xa;&#xa;La FK debe considerarse si hay usuarios asignados." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="270" height="300" as="geometry"/></mxCell>
      <mxCell id="relation" value="ASIGNAR A USER&#xa;&#xa;POST /api/v1/users con role_id&#xa;o PATCH /api/v1/users/{id} con role_id&#xa;&#xa;UserResponse, token y /me conservan role_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="740" height="125" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="runtime-role" name="06 - Persistencia migraciones pruebas">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="Persistencia, migraciones y pruebas con Role" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry"/></mxCell>
      <mxCell id="db" value="MODELO SQL&#xa;&#xa;roles&#xa;- id UUID PK&#xa;- name UNIQUE&#xa;- description&#xa;&#xa;users&#xa;- role_id FK nullable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="260" height="250" as="geometry"/></mxCell>
      <mxCell id="migration" value="MIGRACION ALEMBIC&#xa;&#xa;9b3d4f7a1c2e&#xa;create roles&#xa;unique/index name&#xa;add users.role_id&#xa;create foreign key&#xa;&#xa;alembic upgrade head" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="280" height="250" as="geometry"/></mxCell>
      <mxCell id="unit" value="PRUEBAS UNITARIAS&#xa;&#xa;Role entity&#xa;Role use cases&#xa;User role_id&#xa;Mocks de repositorios&#xa;&#xa;Sin PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="260" height="190" as="geometry"/></mxCell>
      <mxCell id="integration" value="PRUEBAS INTEGRACION&#xa;&#xa;POST /roles&#xa;GET/PATCH/DELETE roles&#xa;Crear User con role_id&#xa;Consultar /me&#xa;Persistencia FK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1120" y="470" width="260" height="190" as="geometry"/></mxCell>
      <mxCell id="repo" value="ADAPTADORES&#xa;&#xa;RoleRepo -> roles&#xa;UserRepo -> users&#xa;RoleUnitOfWork&#xa;UserUnitOfWork" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="200" y="470" width="260" height="190" as="geometry"/></mxCell>
      <mxCell id="e1" value="crea schema" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="migration" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" value="persiste" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="repo" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="verifica" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="unit" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="verifica API + FK" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="integration" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="relation-role" name="07 - Relacion User Role">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" value="Relacion User - Role de extremo a extremo" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry"/></mxCell>
      <mxCell id="request" value="REQUEST&#xa;&#xa;CreateUserRequest&#xa;role_id: UUID opcional&#xa;&#xa;UpdateUser&#xa;role_id: UUID opcional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="190" as="geometry"/></mxCell>
      <mxCell id="usecase" value="CASO DE USO USER&#xa;&#xa;ID.from_string(role_id)&#xa;construye User.role_id&#xa;mantiene el rol al actualizar&#xa;&#xa;UserResponse.role_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="270" height="190" as="geometry"/></mxCell>
      <mxCell id="repo" value="USER REPOSITORY&#xa;&#xa;Entidad User -> DBUser&#xa;user.role_id -> db_user.role_id&#xa;&#xa;users.role_id FK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="270" height="190" as="geometry"/></mxCell>
