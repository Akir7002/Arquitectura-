      <mxCell id="db" value="PERSISTENCIA&#xa;&#xa;UserRepo -> users&#xa;RoleRepo -> roles&#xa;&#xa;users.role_id&#xa;       |&#xa;       v&#xa;roles.id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="900" y="210" width="300" height="270" as="geometry"/></mxCell>
      <mxCell id="auth" value="AUTENTICACION&#xa;&#xa;AuthenticateUserUsecase&#xa;JWTProvider&#xa;&#xa;UserResponse incluye role_id&#xa;token y /me conservan el rol" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="300" height="180" as="geometry"/></mxCell>
      <mxCell id="e1" value="CRUD" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="api" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e2" value="CRUD" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="api" target="role"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e3" value="ensambla" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e4" value="relaciona" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="user" target="role"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e5" value="persiste" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="user" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e6" value="persiste" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="role" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e7" value="incluye role_id" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="user" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
