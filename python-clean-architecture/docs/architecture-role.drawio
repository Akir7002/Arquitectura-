      <mxCell id="relation" value="Relacion principal&#xa;User.role_id -> Role.id&#xa;users.role_id -> roles.id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="540" height="90" as="geometry"/></mxCell>
