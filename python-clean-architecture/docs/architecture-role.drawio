      <mxCell id="api" value="ENTRADA / ENTREGA&#xa;&#xa;app/infra/api&#xa;routers/v1/user.py&#xa;routers/v1/role.py&#xa;dependencies/user.py&#xa;dependencies/role.py&#xa;dependencies/usecases/role.py&#xa;extensions.py&#xa;lifespan.py" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="450" as="geometry"/></mxCell>
      <mxCell id="core" value="NUCLEO&#xa;&#xa;app/core&#xa;entities/user.py&#xa;entities/role.py&#xa;dtos/user.py&#xa;dtos/role.py&#xa;ports/user.py&#xa;ports/role.py&#xa;usecases/user/*&#xa;usecases/role/*&#xa;exceptions.py" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="450" as="geometry"/></mxCell>
      <mxCell id="infra" value="ADAPTADORES&#xa;&#xa;db/models/user.py&#xa;db/models/role.py&#xa;db/repositories/user.py&#xa;db/repositories/role.py&#xa;db/unit_of_work/*&#xa;auth/jwt.py&#xa;security/crypto.py&#xa;migrations/*" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="300" height="450" as="geometry"/></mxCell>
      <mxCell id="external" value="EXTERNO&#xa;&#xa;PostgreSQL&#xa;roles&#xa;users.role_id&#xa;Passlib / bcrypt&#xa;JWT&#xa;Alembic" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1090" y="110" width="250" height="450" as="geometry"/></mxCell>
      <mxCell id="a" value="HTTP" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="external" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="b" value="llama" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="api" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="c" value="implementa puertos" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="infra" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="d" value="DB y servicios" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="infra" target="external"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
