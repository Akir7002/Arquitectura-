  <diagram id="layers-role" name="02 - Capas y carpetas con Role">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
