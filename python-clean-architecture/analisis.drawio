        </mxCell>
        <mxCell id="layercore" value="2. NUCLEO&#xa;&#xa;app/core&#xa;&#xa;dtos/*&#xa;entities/user.py&#xa;value_objects/*&#xa;ports/*&#xa;usecases/user/*&#xa;exceptions.py" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="280" height="430" as="geometry" />
        </mxCell>
        <mxCell id="layerinfra" value="3. ADAPTADORES&#xa;&#xa;app/infra/db&#xa;app/infra/auth&#xa;app/infra/security&#xa;&#xa;models/user.py&#xa;repositories/user.py&#xa;unit_of_work/*&#xa;auth/jwt.py&#xa;security/crypto.py&#xa;migrations/*" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="280" height="430" as="geometry" />
        </mxCell>
