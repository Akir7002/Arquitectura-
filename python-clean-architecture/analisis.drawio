          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="implementa puertos" style="endArrow=block;dashed=1;html=1;strokeColor=#000000;fontColor=#000000;fontSize=13;" edge="1" parent="1" source="layerinfra" target="layercore">
