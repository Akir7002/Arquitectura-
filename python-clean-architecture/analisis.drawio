  <diagram id="flows" name="05 - Flujos de usuario y auth">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title5" value="Flujos funcionales detallados" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="create5" value="CREAR USUARIO&#xa;&#xa;POST /api/v1/users&#xa;1. CreateUserRequest&#xa;2. Email + Password&#xa;3. Buscar email duplicado&#xa;4. Hashear password&#xa;5. Crear User con ID&#xa;6. UserRepo.save&#xa;7. UoW.commit&#xa;8. UserResponse / 201" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="login5" value="AUTENTICAR&#xa;&#xa;POST /api/v1/auth/token&#xa;1. Form username=email&#xa;2. Validar Email&#xa;3. Buscar por email&#xa;4. Hasher.verify&#xa;5. Crear JWT con user_id&#xa;6. TokenResponse / 200&#xa;&#xa;Fallo -&gt; 401" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="120" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="me5" value="CONSULTAR PERFIL&#xa;&#xa;GET /api/v1/auth/me&#xa;1. Leer Bearer token&#xa;2. OAuth2PasswordBearer&#xa;3. JWTProvider.get_sub&#xa;4. GetUserUsecase&#xa;5. UserRepo.get_by_id&#xa;6. UserResponse / 200&#xa;&#xa;Fallo -&gt; 401" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="120" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="crud5" value="CRUD REST&#xa;&#xa;GET /users/{id} -&gt; 200 / 404&#xa;PATCH /users/{id} -&gt; UoW + commit&#xa;DELETE /users/{id} -&gt; 204 / 404&#xa;&#xa;UUID invalido -&gt; 422 antes del caso de uso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="120" width="270" height="300" as="geometry" />
        </mxCell>
        <mxCell id="return5" value="Todos los flujos devuelven DTOs publicos; nunca exponen password ni password_hash." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=15;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="520" width="850" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="runtime" name="06 - Arranque persistencia pruebas">
    <mxGraphModel dx="1452" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#000000;align=left;" value="Arranque, persistencia, migraciones y pruebas" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="boot6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;verticalAlign=top;spacingTop=12;" value="ARRANQUE&#xa;&#xa;python -m app&#xa;-&gt; app/__main__.py&#xa;-&gt; start_server()&#xa;-&gt; Uvicorn&#xa;-&gt; create_app(Settings)&#xa;-&gt; routers + extensions&#xa;-&gt; lifespan startup&#xa;-&gt; engine disponible" vertex="1">
