          <mxGeometry x="40" y="30" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layerapi" value="1. ENTRADA / ENTREGA&#xa;&#xa;app/infra/api&#xa;&#xa;app.py&#xa;routers/root.py&#xa;routers/v1/user.py&#xa;routers/v1/auth.py&#xa;dependencies/*&#xa;extensions.py&#xa;lifespan.py" style="swimlane;html=1;rounded=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=14;horizontal=1;startSize=32;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
